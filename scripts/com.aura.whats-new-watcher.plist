<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent for the "Draft this week's email now" watcher (Admin ▸ What's New).
  Asks the website once a minute — a plain HTTP request, no Claude — and starts Claude only when
  the button has been pressed. See docs/weekly-product-update.md.

  This is a TEMPLATE. To activate (you, not the assistant, turn on autostart):
    cp scripts/com.aura.whats-new-watcher.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.aura.whats-new-watcher.plist

  To stop / remove:
    launchctl bootout gui/$(id -u)/com.aura.whats-new-watcher
    rm ~/Library/LaunchAgents/com.aura.whats-new-watcher.plist

  Logs: ~/Library/Logs/aura-whats-new-watcher.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aura.whats-new-watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mefenemer/WebstormProjects/Be More Swan/scripts/whats-new-watcher-service.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mefenemer/WebstormProjects/Be More Swan</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/mefenemer/Library/Logs/aura-whats-new-watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mefenemer/Library/Logs/aura-whats-new-watcher.log</string>
</dict>
</plist>
